# Plantilla: reemplaza valores, copia a .env.production y guarda ese archivo fuera de Git.
PUBLIC_DOMAIN=buscacampus.example.invalid
PUBLIC_ORIGIN=https://buscacampus.example.invalid
DATABASE_URL=postgres://buscacampus:replace_me@db.example.invalid:5432/buscacampus?sslmode=require
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_bytes
JWT_EXPIRES_IN=8h
PGSSL=true
REPORT_UPLOADS_PATH=/srv/buscacampus/uploads
CLAIM_EVIDENCE_PATH=/srv/buscacampus/private_uploads
